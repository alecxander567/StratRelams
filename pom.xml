<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.cardgame</groupId>
    <artifactId>card-game</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <properties>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <javafx.version>21.0.10</javafx.version>

        <!-- Path to the JavaFX SDK lib folder for jpackage/jlink. -->
        <javafx.jmods.path>C:/Users/Lenovo/javafx-sdk-21.0.10/lib</javafx.jmods.path>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-fxml</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-media</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
            <version>3.46.0.0</version>
        </dependency>
        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
            <version>2.11.0</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Run the app during development: mvn javafx:run -->
            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <version>0.0.8</version>
                <configuration>
                    <mainClass>com.cardgame.App</mainClass>
                </configuration>
            </plugin>

            <!-- Copy dependency jars into target/package-input for jpackage. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <id>copy-dependencies</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>copy-dependencies</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/package-input</outputDirectory>
                            <includeScope>runtime</includeScope>
                            <!-- Exclude JavaFX artifacts; they go on the module-path instead. -->
                            <excludeGroupIds>org.openjfx</excludeGroupIds>
                            <overWriteReleases>true</overWriteReleases>
                            <overWriteSnapshots>true</overWriteSnapshots>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Also copy the app jar itself into target/package-input. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <version>3.3.1</version>
                <executions>
                    <execution>
                        <id>copy-app-jar-to-package-input</id>
                        <phase>package</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/package-input</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>${project.build.directory}</directory>
                                    <includes>
                                        <include>${project.build.finalName}.jar</include>
                                    </includes>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Build the Windows installer with jpackage. -->
            <!-- Triggered by: mvn package (or mvn antrun:run@jpackage-installer) -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <execution>
                        <id>jpackage-installer</id>
                        <phase>package</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <exec executable="jpackage" failonerror="true">
                                    <arg value="--type"/>
                                    <arg value="exe"/>

                                    <arg value="--input"/>
                                    <arg value="${project.build.directory}/package-input"/>

                                    <arg value="--main-jar"/>
                                    <arg value="${project.build.finalName}.jar"/>

                                    <arg value="--main-class"/>
                                    <arg value="com.cardgame.App"/>

                                    <arg value="--name"/>
                                    <arg value="StratRealms"/>

                                    <arg value="--app-version"/>
                                    <arg value="1.0.0"/>

                                    <arg value="--vendor"/>
                                    <arg value="StratRealms"/>

                                    <arg value="--description"/>
                                    <arg value="Fantasy tactical strategy board game"/>

                                    <arg value="--icon"/>
                                    <arg value="${project.basedir}/src/main/resources/assets/icon_logo.ico"/>

                                    <arg value="--module-path"/>
                                    <arg value="${javafx.jmods.path}"/>

                                    <arg value="--add-modules"/>
                                    <arg value="javafx.controls,javafx.media"/>

                                    <arg value="--win-shortcut"/>
                                    <arg value="--win-menu"/>
                                    <arg value="--win-dir-chooser"/>

                                    <arg value="--dest"/>
                                    <arg value="${project.build.directory}/installer"/>
                                </exec>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
